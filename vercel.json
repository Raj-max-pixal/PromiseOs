{
  "version": 2,
  "cleanUrls": false,
  "builds": [
    { "src": "index.js", "use": "@vercel/node", "config": { "includeFiles": ["public/**"] } },
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/memories", "dest": "/api/memories.js" },
    { "src": "/api/chat", "dest": "/api/chat.js" },
    { "src": "/(.*)", "dest": "/index.js" }
  ],
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }]
}
